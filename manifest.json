{
  "manifest_version": 3,
  "name": "GafiGoogle",
  "version": "1.1.0",
  "description": "Animações suaves e discretas para a interface normal do Google.",
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/*",
        "https://www.google.pt/*",
        "https://www.google.co.uk/*",
        "https://www.google.es/*",
        "https://www.google.fr/*",
        "https://www.google.de/*",
        "https://www.google.it/*",
        "https://www.google.ca/*",
        "https://www.google.com.br/*",
        "https://www.google.com.au/*",
        "https://www.google.co.in/*",
        "https://www.google.co.jp/*"
      ],
      "css": ["src/content.css"],
      "js": ["src/content.js"],
      "run_at": "document_start"
    }
  ]
}